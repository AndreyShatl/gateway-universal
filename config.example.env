# =====================================================================
# gateway-universal — конфигурация для install.sh
#
# Скопируйте в config.env и заполните параметры:
#   cp config.example.env config.env
#   nano config.env
#
# Или задайте переменные в окружении перед запуском install.sh:
#   VPS_ADDR=1.2.3.4 VPS_PORT=443 sudo -E bash install.sh
#
# Или запустите install.sh без config.env — он спросит параметры интерактивно.
# =====================================================================

# --- VPS (VLESS + Reality) — обязательно -----------------------------
# Получается при создании Inbound в 3x-ui панели на VPS
VPS_ADDR=""                    # IP или домен VPS
VPS_PORT_VISION="443"          # порт для TCP+Reality+Vision (основной канал)
VPS_PORT_GRPC="2083"           # порт для gRPC+Reality (для Meta/Instagram)

# UUID пользователей — из 3x-ui (разные для двух inbound'ов)
VPS_UUID_VISION=""             # UUID первого клиента (порт vision)
VPS_UUID_GRPC=""               # UUID второго клиента (порт gRPC)

# Reality параметры — из 3x-ui (одинаковые для обоих inbound'ов обычно)
VPS_PUBKEY=""                  # Public Key Reality
VPS_SHORT_ID=""                # Short ID Reality
VPS_SERVER_NAME="www.cloudflare.com"   # Reality SNI (какой сайт маскируется)
VPS_FINGERPRINT="chrome"               # Reality fingerprint

# --- Сеть ------------------------------------------------------------
LAN="192.168.0.0/16"           # локальная подсеть (192.168.0.0/16 покрывает все типовые)
IFACE=""                       # внешний интерфейс — если пусто, определится автоматически

# --- Пути установки --------------------------------------------------
INSTALL_PREFIX="/opt"          # корень установки: /opt/xray, /opt/zapret, /opt/zapret-config

# --- Что ставить -----------------------------------------------------
INSTALL_XRAY="yes"             # установить xray (VLESS прокси)
INSTALL_ZAPRET="yes"           # установить zapret (nfqws DPI bypass)
BUILD_ZAPRET_FROM_SOURCE="yes" # собрать zapret из исходников (иначе — готовый бинарник)

# --- Функциональность -----------------------------------------------
INSTAGRAM_QUIC_BYPASS="yes"    # разрешить QUIC к Meta IP для Instagram на мобиле
BLOCK_QUIC="yes"               # блокировать остальной QUIC (принудительный fallback на TCP)
