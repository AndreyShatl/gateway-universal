[Unit]
Description=Gateway brain worker (очередь: solve -> zapret/VPS)
After=network-online.target xray.service zapret.service
Wants=network-online.target

[Service]
Environment=SOLVE=/opt/gateway-brain/solve.sh APPLY=/opt/gateway-brain/brain-apply.sh GWDB=/root/gateway-universal/scripts/gwdb.py
ExecStart=/opt/gateway-brain/brain-worker.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
