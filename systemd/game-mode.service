[Unit]
Description=Game Mode — blanket ACCEPT for ephemeral game-server ports
After=network-online.target zapret.service discord-tproxy.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '/opt/gateway/game-mode.sh "$(cat /etc/gateway/game-mode.conf 2>/dev/null || echo off)"'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
