[Unit]
Description=Еженедельная проверка обновлений ciadpi (раз в неделю)

[Timer]
# Воскресенье 02:30 — через 30 мин после zapret-автообновления (02:00), чтобы не
# соревноваться за git/make/systemd-run, и всё ещё ДО ночных brain-таймеров (04:00+).
OnCalendar=Sun *-*-* 02:30:00
RandomizedDelaySec=1200
Persistent=true

[Install]
WantedBy=timers.target
