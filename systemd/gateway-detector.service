[Unit]
Description=Gateway auto-route detector (pcap → prober → applier)
After=network-online.target xray.service dnscrypt-proxy.service
Wants=network-online.target

[Service]
# Запускается/останавливается gateway-ui по тумблеру «Авто-обход».
# Пассивный pcap-детект блоков + перепроверка через VPS + применение (ipset).
# eBPF-вариант (T59, экспериментальный, только x86_64) — см.
# systemd/gateway-detector-ebpf.service, не default для свежих установок.
ExecStart=/opt/gateway-detector watch --apply --config-env /root/gateway-universal/config.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
