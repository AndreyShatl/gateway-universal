[Unit]
Description=Еженедельная проверка обновлений zapret (раз в неделю)

[Timer]
# Воскресенье 02:00 — ДО ночных brain-таймеров (nightly/recheck в 04:00, static-reeval
# в 05:00), чтобы restore (после рестарта zapret) успел устаканиться заранее и не
# соревновался с ними за netns/тестовую очередь solve.sh.
OnCalendar=Sun *-*-* 02:00:00
RandomizedDelaySec=1200
Persistent=true

[Install]
WantedBy=timers.target
